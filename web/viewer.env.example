# Source this from the repository root in EVERY backend/worker terminal.
# No credentials; do not change paths/profile while existing jobs are queued.
export VIEWER_CONFIG="$PWD/web/viewer.config.json"
export VIEWER_RUNS_ROOT="$PWD/work_dirs"
export VIEWER_STATE_ROOT="$PWD/work/viewer"
export VIEWER_DATA_ROOTS="[\"$PWD/data/nuscenes\"]"
export VIEWER_EVALUATION_ROOTS="[\"$PWD/work_dirs\"]"
export VIEWER_BENCHMARK_ROOTS="[\"$PWD/work_dirs\"]"
export VIEWER_JOB_PROFILES="$PWD/web/inference_profiles.json"
export VIEWER_GPU_LOCK="$PWD/work/inference-worker/gpu.lock"
export VIEWER_CAMERA_POLICY="$PWD/web/camera_policy.json"
export VIEWER_API_ORIGIN="http://127.0.0.1:8000"
export VIEWER_NEXT_DIST_DIR=".next"
# Worker is explicit opt-in; this example never starts one.
export VIEWER_START_WORKER=0
